{
  "id": "io.github.nalladev.cosmic-notes",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.llvm20"
  ],
  "command": "cosmic-notes",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--talk-name=com.system76.CosmicSettingsDaemon.*",
    "--talk-name=com.system76.CosmicSettingsDaemon",
    "--device=dri",
    "--filesystem=xdg-documents"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm20/bin",
    "env": {
      "CARGO_HOME": "/run/build/cosmic-notes/cargo",
      "LIBCLANG_PATH": "/usr/lib/sdk/llvm20/lib"
    }
  },
  "modules": [
    {
      "name": "cosmic-notes",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --verbose",
        "install -Dm0755 ./target/release/cosmic-notes /app/bin/cosmic-notes",
        "install -Dm0644 ./resources/app.desktop /app/share/applications/io.github.nalladev.cosmic-notes.desktop",
        "install -Dm0644 ./resources/app.metainfo.xml /app/share/metainfo/io.github.nalladev.cosmic-notes.metainfo.xml",
        "install -Dm0644 ./resources/icon.svg /app/share/icons/hicolor/scalable/apps/io.github.nalladev.cosmic-notes.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/nalladev/cosmic-notes.git",
          "tag": "v0.1.0"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
